<?xml version="1.0" encoding="utf-8"?>
<!--
  A real manifest entry, not boilerplate: fetching remote config needs these at runtime and the
  module declares its own requirements rather than relying on the app to remember them.
  The manifest merger folds them into composeApp.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
