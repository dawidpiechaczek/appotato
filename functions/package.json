{
  "name": "appotato-functions",
  "description": "Server-side proxy for anything the app must not hold a key for.",
  "private": true,
  "type": "commonjs",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "contract:check": "tsc && node lib/contract-check.js",
    "smoke": "tsc && node lib/smoke.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy:dev": "firebase deploy --only functions -P dev",
    "deploy:prod": "firebase deploy --only functions -P prod"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "firebase-tools": "^15.27.0",
    "typescript": "^5.9.3"
  }
}
